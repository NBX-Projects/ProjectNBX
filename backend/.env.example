# LiveKit SFU Configuration
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PORT=7880
LIVEKIT_TCP_PORT=7880
LIVEKIT_UDP_PORT_RANGE=50000-50020
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Backend API Configuration
APP_ENV=development
PORT=8080
JWT_SECRET=super_secret_jwt_key_projectnbx_change_me_in_production
DATABASE_URL=postgres://admin:nbx_pass@localhost:8190/nbx_stream?sslmode=disable
ALLOWED_ORIGINS=*
AUDIT_ADMIN_USER_IDS=

# Production deployment values belong in the server environment, not this file.
# The production Compose overlay also requires pinned LIVEKIT_SERVER_VERSION and
# LIVEKIT_INGRESS_VERSION values.

# Adminer Web UI
ADMINER_PORT=8082
